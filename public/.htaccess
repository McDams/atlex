<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcer HTTPS (sauf en local).
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Rediriger les requêtes vers le front controller si le fichier n'existe pas.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

<!--
    La Content-Security-Policy est désormais générée par PHP
    (app/Core/Security.php) afin d'inclure un nonce différent à chaque
    requête pour script-src — voir public/index.php.
-->

<FilesMatch "\.(env|sql|md|json|lock)$">
    Require all denied
</FilesMatch>

Options -Indexes
ServerSignature Off