<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rediriger les requêtes vers le front controller si le fichier n'existe pas.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Sécurité : interdire l'accès aux fichiers sensibles.
<FilesMatch "\.(env|sql|md|json|lock)$">
    Require all denied
</FilesMatch>

Options -Indexes
