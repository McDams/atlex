# Valeurs sûres par défaut (production). En local, passer
# APP_ENV=development et APP_DEBUG=true.
APP_NAME="ATLEX - Sport"
APP_URL=https://atlex-sport.com
APP_ENV=production
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=atlex_sport
DB_USER=root
DB_PASS=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=contact@atlex-sport.com
MAIL_PASS=
# Chiffrement SMTP : tls (port 587) ou ssl (port 465)
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME="ATLEX - Sport"

# Hostinger API
HOSTINGER_API_TOKEN=
ADMIN_EMAIL=admin@atlexsport.com

# Bandeau d'actualités (ticker) — flux RSS Google Actualités, rubrique Sport.
# Laisser vide pour utiliser le flux Sport français par défaut.
# Exemple Bénin : https://news.google.com/rss/headlines/section/topic/SPORTS?hl=fr&gl=BJ&ceid=BJ:fr
NEWS_FEED_URL=

# Géolocalisation IP (carte des visites dans Analytics) — clé de licence
# gratuite MaxMind : https://www.maxmind.com/en/geolite2/signup
# Utilisée par cron/geoip_update.php pour télécharger storage/geoip/GeoLite2-City.mmdb
MAXMIND_LICENSE_KEY=

# Assistant IA réseaux sociaux (/admin/social) et articles Actualités —
# génère des brouillons, jamais de publication automatique. Clé gratuite
# (aucune carte bancaire requise) sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Résumés de matchs (Coupe du Monde, CAN, Ligue des Champions...) — clé
# RapidAPI (compte gratuit), abonnée à l'API "Sofascore" (éditeur Api Dojo)
SOFASCORE_API_KEY=
