{
  "name": "atlex-sport",
  "version": "1.0.0",
  "description": "Plateforme web de l'association sportive ATLEX - Sport (Cotonou, Bénin).",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./public/assets/css/app.css -o ./public/assets/css/app.min.css --minify",
    "watch:css": "tailwindcss -i ./public/assets/css/app.css -o ./public/assets/css/app.min.css --watch",
    "build:js": "esbuild public/assets/js/app.js public/assets/js/admin.js public/assets/js/calendar.js public/assets/js/gallery.js --minify --outdir=public/assets/js --entry-names=[name].min",
    "build": "npm run build:css && npm run build:js",
    "images": "node scripts/convert-images.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0"
  }
}
