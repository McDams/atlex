{
    "name": "atlex-sport/platform",
    "description": "Plateforme numérique ATLEX - Sport",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "geoip2/geoip2": "^3.1",
        "phpmailer/phpmailer": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php",
            "app/Helpers/constants.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
